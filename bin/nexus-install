#!/usr/bin/env bash
# NexusOS 单文件安装器 —— 供 `curl ... | bash` 使用。
#
#   curl -fsSL https://github.com/AndyZhuang/nexusOS/releases/latest/download/nexus-install.sh | bash
#
# 行为：
#   1. 解析通道与版本（环境变量 NEXUS_CHANNEL / NEXUS_VERSION 可覆盖）
#   2. 下载 tarball 产物
#   3. 校验 sha256（可用 NEXUS_GPG_KEY / NEXUS_REQUIRE_SIGN=1 强制签名校验）
#   4. 解包并调用 bootstrap 安装
#
# 环境变量：
#   NEXUS_CHANNEL      stable(默认) | rc | edge | dev
#   NEXUS_VERSION      指定版本，默认取 latest
#   NEXUS_REPO         GitHub 仓库，默认 AndyZhuang/nexusOS
#   NEXUS_BASE_URL     直接指定下载基址（镜像/自建）
#   NEXUS_REQUIRE_SIGN 设为 1 时必须验签
#   NEXUS_DATA_HOME / NEXUS_CONFIG_HOME  覆盖默认路径
set -euo pipefail

CHANNEL="${NEXUS_CHANNEL:-stable}"
REPO_SLUG="${NEXUS_REPO:-AndyZhuang/nexusOS}"
BASE="${NEXUS_BASE_URL:-https://github.com/$REPO_SLUG/releases/download}"

say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

command -v python3 >/dev/null 2>&1 || die "需要 python3 (3.11+)"
python3 -c "import sys; assert sys.version_info>=(3,11)" 2>/dev/null \
  || die "需要 python3 3.11+ (缺 tomllib)"

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# ---- 1. 解析产物 URL ----------------------------------------------------
if [ "$CHANNEL" = "stable" ]; then
  VERSION="${NEXUS_VERSION:-latest}"
  if [ "$VERSION" = "latest" ]; then
    say "查询最新版本…"
    VERSION="$(curl -fsSL "https://api.github.com/repos/$REPO_SLUG/releases/latest" \
      | python3 -c "import sys,json; print(json.load(sys.stdin)['tag_name'].lstrip('v'))" \
      2>/dev/null || echo "")"
    [ -n "$VERSION" ] || die "无法解析最新版本，请显式设置 NEXUS_VERSION"
  fi
  URL="$BASE/v$VERSION/nexusos-$VERSION.tar.gz"
  SHA_URL="$URL.sha256"
  SIG_URL="$URL.sig"
else
  VERSION="${NEXUS_VERSION:-edge}"
  URL="$BASE/$CHANNEL/nexusos-$CHANNEL.tar.gz"
  SHA_URL="$URL.sha256"
  SIG_URL="$URL.sig"
fi

say "通道 $CHANNEL · 版本 ${VERSION}"
say "下载 $URL"
curl -fL --progress-bar "$URL" -o "$WORK/artifact.tar.gz" || die "下载失败"

# ---- 2. 校验 ------------------------------------------------------------
if [ -f "$WORK/artifact.tar.gz.sha256" ] || curl -fsSL "$SHA_URL" -o "$WORK/artifact.tar.gz.sha256" 2>/dev/null; then
  ( cd "$WORK" && sha256sum -c artifact.tar.gz.sha256 ) >/dev/null 2>&1 \
    || die "sha256 校验失败 —— 产物可能已损坏或被篡改"
  printf '  \033[32m✓\033[0m sha256 校验通过\n'
else
  printf '  \033[33m!\033[0m 无 sha256 可校验\n'
  [ "${NEXUS_REQUIRE_SIGN:-0}" = "1" ] && die "NEXUS_REQUIRE_SIGN=1 但无校验和"
fi

if command -v gpg >/dev/null 2>&1; then
  if curl -fsSL "$SIG_URL" -o "$WORK/artifact.tar.gz.sig" 2>/dev/null; then
    if curl -fsSL "$BASE/nexusos.pub" -o "$WORK/nexusos.pub" 2>/dev/null \
       && gpg --import "$WORK/nexusos.pub" 2>/dev/null \
       && gpg --verify "$WORK/artifact.tar.gz.sig" "$WORK/artifact.tar.gz" 2>/dev/null; then
      printf '  \033[32m✓\033[0m GPG 签名校验通过\n'
    else
      printf '  \033[33m!\033[0m 签名校验未通过\n'
      [ "${NEXUS_REQUIRE_SIGN:-0}" = "1" ] && die "签名校验失败"
    fi
  fi
fi

# ---- 3. 解包 + 安装 -----------------------------------------------------
say "解包"
mkdir -p "$WORK/x"
tar -xzf "$WORK/artifact.tar.gz" -C "$WORK/x"
PAYLOAD="$WORK/x/payload"
[ -d "$PAYLOAD" ] || PAYLOAD="$WORK/x"
[ -d "$PAYLOAD/lib/nexus" ] || die "产物结构异常"

say "安装"
export NEXUS_CHANNEL="$CHANNEL"
export NEXUS_INSTALL_PAYLOAD="$PAYLOAD"
python3 - "$PAYLOAD" <<'PY'
import os, sys, pathlib
payload = pathlib.Path(sys.argv[1])
sys.path.insert(0, str(payload / "lib"))
from nexus.install import bootstrap
report = bootstrap(source=payload / "lib" / "nexus", enable=True, quiet=True)
print("  安装完成:", report.get("version", {}).get("version"),
      "通道:", report.get("version", {}).get("channel"))
PY

say "验证"
export PATH="$HOME/.local/bin:$PATH"
nexus version || die "安装后自检失败"

cat <<EOF

  NexusOS 已就绪。

    nexus status        系统总览
    nexus gpu           显存与模型
    nexus permissions   权限档位
    nexus               新手引导
    nexus "<自然语言>"   对话式控制面
    nexus update        更新（唯一受支持的入口）
    nexus channel list  发布通道

EOF
